# Copy this file to grill.env and edit as needed, then: systemctl --user restart grill
# Every line is optional.

# Web server port
#GRILL_PORT=8080

# 0.0.0.0 = page visible on the whole local network (e.g. from a phone), 127.0.0.1 = this computer only
#GRILL_HOST=0.0.0.0

# MAC address of a specific thermometer (default: first device whose name starts with "Grill")
#GRILL_MAC=AA:BB:CC:DD:EE:FF

# Where CSV logs are written
#GRILL_LOG_DIR=~/grill_logs

# Where alarm limits are stored (alarms.json)
#GRILL_CONFIG_DIR=~/.config/grill
